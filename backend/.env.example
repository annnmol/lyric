# ─── Backend config ───────────────────────────────────────────
# All values are optional — defaults work for local development.
# Copy this file to .env and tweak as needed.

# HTTP port the Express server listens on
PORT=8765

# Allowed origin for CORS (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Python interpreter used to run scripts/align.py
# Default resolves to backend/.venv/bin/python relative to this file
LYRIC_PYTHON=.venv/bin/python

# Where uploaded audio / images / videos are stored
UPLOADS_DIR=uploads

# Where rendered MP4s are written
OUT_DIR=out

# Max upload size in MB (audio + background)
MAX_UPLOAD_MB=200
